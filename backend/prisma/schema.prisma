generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  name         String
  passwordHash String
  profile      UserProfile?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String       @id @default(uuid())
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId String?
  profile   UserProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@index([userId])
}

model UserProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  experienceLevel String
  jobRole         String
  targetCompany   String?
  skills          String[]
  bio             String?
  location        String?
  avatarUrl       String?

  cvUrl           String?
  cvText          String? @db.Text
  cvFileName      String?

  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model MockInterviewTranscript {
  id              String   @id @default(cuid())
  clientSessionId String   @unique
  userId          String
  model           String?
  status          String   @default("COMPLETED")

  startedAt       DateTime
  endedAt         DateTime
  durationSeconds Int

  messages        Json
  events          Json
  transcriptText  String   @db.Text
  evaluation      InterviewEvaluation?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, endedAt])
}

enum InterviewEvaluationStatus {
  NOT_STARTED
  PROCESSING
  COMPLETED
  INSUFFICIENT_DATA
  FAILED
}

model InterviewEvaluation {
  id           String                   @id @default(cuid())
  transcriptId String                   @unique
  userId       String
  status       InterviewEvaluationStatus @default(NOT_STARTED)

  overallScore Int?
  grade        String?

  technicalAccuracy Int?
  problemSolving    Int?
  communication     Int?
  relevance         Int?
  depthOfKnowledge  Int?

  report       Json?
  model        String?
  promptVersion String @default("v1")

  errorMessage String? @db.Text
  evaluatedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transcript   MockInterviewTranscript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt])
}